# Used only to initialize the administrator. Change it in the UI after setup.
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
PUBLIC_URL=http://tv.example.com:9000
HTTP_BIND=0.0.0.0
HTTP_PORT=9000
# Pin this to a tested PyPI yt-dlp version when building/upgrading.
YTDLP_VERSION=2026.8.19
CACHE_MB=32
LOG_LEVEL=info
